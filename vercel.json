{
  "redirects": [
    {
      "source": "/bg/:path*",
      "has": [{ "type": "host", "value": "gcp.bg" }],
      "destination": "https://philippopolis.club/bg/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "gcp.bg" }],
      "destination": "https://philippopolis.club/bg/",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "gcp.bg" }],
      "destination": "https://philippopolis.club/bg/:path*",
      "permanent": true
    },
    {
      "source": "/bg/:path*",
      "has": [{ "type": "host", "value": "www.gcp.bg" }],
      "destination": "https://philippopolis.club/bg/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.gcp.bg" }],
      "destination": "https://philippopolis.club/bg/",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "www.gcp.bg" }],
      "destination": "https://philippopolis.club/bg/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/images/gallery/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=2592000" }]
    }
  ]
}
